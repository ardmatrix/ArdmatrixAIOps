COMPOSE_PROJECT_NAME=ardmatrix-aiops

TIMESCALE_IMAGE=timescale/timescaledb:latest-pg17
POSTGRES_DB=aiops
POSTGRES_USER=aiops
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_PORT=5432

KAFKA_IMAGE=apache/kafka:4.1.1
KAFKA_PORT=9092
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:v0.7.2
KAFKA_UI_PORT=8085

PROMETHEUS_IMAGE=prom/prometheus:v3.5.0
PROMETHEUS_PORT=9090

GRAFANA_IMAGE=grafana/grafana:12.1.1
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-production

INVENTORY_POLL_SECONDS=3
INVENTORY_STABLE_SCANS=2
INVENTORY_WATCHER_METRICS_PORT=9101
INVENTORY_CONSUMER_METRICS_PORT=9102
SOURCE_INGESTION_PORT=8091
SOURCE_FILE_WATCHER_METRICS_PORT=9106
SOURCE_FILE_POLL_SECONDS=3
# Change this outside local demos. Clients send: Authorization: Bearer <token>
SOURCE_API_TOKEN=demo-local-token
SIMULATOR_RUN_KEY=customer-demo-10d-v1
SIMULATOR_INTERVAL_SECONDS=900
SIMULATOR_DURATION_DAYS=10
SIMULATOR_METRICS_PORT=9107
AI_EVENT_CONSUMER_METRICS_PORT=9108
INFRASTRUCTURE_METRIC_CONSUMER_PORT=9109

# Inventory AI assistant: simple questions use the free database fast path;
# complex questions use OpenAI. Never commit a real API key.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_REASONING_EFFORT=none
OPENAI_API_KEY=
INVENTORY_ASSISTANT_MAX_COMPLETION_TOKENS=256
INVENTORY_ASSISTANT_PORT=8090
INVENTORY_ASSISTANT_MAX_ROWS=50

# Optional local fallback runtime
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_MODEL=qwen3.5:2b
