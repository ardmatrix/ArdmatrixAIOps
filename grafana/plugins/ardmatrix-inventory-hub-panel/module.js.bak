.noc{position:relative;width:100%;height:100%;min-height:760px;overflow:hidden;background:#020918;font-family:Inter,Arial,sans-serif;color:#fff}.noc:before{content:"";position:absolute;inset:0;background:url('/public/plugins/ardmatrix-inventory-hub-panel/img/datacenter-background.png') center/cover;opacity:.38}.noc:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,7,22,.76),rgba(0,18,47,.3) 50%,rgba(0,7,22,.76)),linear-gradient(rgba(0,7,20,.24),rgba(0,8,22,.6))}
.brand{position:absolute;z-index:5;top:5px;left:50%;transform:translateX(-50%);width:390px;height:76px;background:rgba(1,10,26,.78);clip-path:polygon(10% 0,90% 0,100% 100%,0 100%)}.brand img{width:100%;height:100%;object-fit:contain}.tag{position:absolute;z-index:6;top:70px;left:50%;transform:translateX(-50%);font-size:9px;letter-spacing:.25em;color:#c7def0}
.main{position:absolute;z-index:3;top:100px;left:3%;right:3%;bottom:255px;display:grid;grid-template-columns:25% 1fr 25%;gap:4%}.col{display:grid;grid-template-rows:repeat(3,1fr);gap:19px}.card{display:flex;align-items:center;gap:20px;padding:15px 20px;border:1px solid #079fe9;border-radius:22px;background:linear-gradient(120deg,rgba(2,29,65,.97),rgba(1,16,40,.94));color:#fff;text-decoration:none;box-shadow:inset 0 0 26px rgba(0,121,230,.14)}.card:hover{color:#fff;border-color:#73eaff;box-shadow:0 0 24px rgba(0,168,255,.38)}.ico{flex:0 0 78px;height:78px;border:2px solid #46dbff;border-radius:50%;display:grid;place-items:center;font-size:40px;color:#e8fcff;box-shadow:0 0 17px #087fff,inset 0 0 18px rgba(0,128,255,.25)}.num{font-size:37px;font-weight:800}.lbl{margin-top:5px;font-size:13px;letter-spacing:.07em}.det{margin-top:12px;padding-top:8px;border-top:1px solid #236d98;color:#cadbe5;font-size:10px;white-space:nowrap}.g{color:#38eb83}.y{color:#ffda2d}.r{color:#ff4f5c}.c{color:#25d7ff}
.middle{display:flex;align-items:center;justify-content:center}.hub{position:relative;width:min(30vw,390px);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;text-align:center;background:radial-gradient(circle,rgba(2,31,69,.98) 0 48%,rgba(0,68,155,.35) 49%);border:2px solid #2bd2ff;box-shadow:0 0 18px #0067ff,0 0 0 12px rgba(16,76,198,.58),0 0 0 14px #29bfff,0 0 0 28px rgba(5,72,174,.4),0 0 55px #0049ff}.hub:before{content:"";position:absolute;inset:20%;border:1px dashed #108cff;border-radius:50%;background-image:radial-gradient(#0975b9 1px,transparent 1px);background-size:15px 15px;opacity:.55}.hubtxt{position:relative}.hubtxt b{display:block;font-size:38px}.hubtxt strong{display:block;color:#1bcaff;font-size:39px}.hubtxt span{display:block;margin-top:11px;font-size:11px;letter-spacing:.24em}.health{position:absolute;bottom:-37px;left:50%;transform:translateX(-50%);width:190px;padding:8px;border:1px solid #078ce7;border-radius:35px;background:#031834}.health small{display:block;font-size:9px}.health b{font-size:29px;color:#38e579}
.intel{position:absolute;z-index:4;left:2.6%;right:2.6%;bottom:104px;height:123px;display:grid;grid-template-columns:repeat(5,1fr);border:1px solid #087dc7;border-radius:19px;background:rgba(2,22,51,.96)}.ii{display:flex;align-items:center;justify-content:center;gap:14px;border-right:1px solid #145a8b}.ii:last-child{border:0}.iiicon{width:52px;height:52px;border:1px solid currentColor;border-radius:50%;display:grid;place-items:center;font-size:24px}.iit{font-size:9px;color:#d3e5ef}.iiv{font-size:28px;font-weight:800}.iis{margin-top:5px;font-size:8px;color:#b6cad6}
.nav{position:absolute;z-index:4;left:1.3%;right:1.3%;bottom:19px;height:68px;display:grid;grid-template-columns:repeat(10,1fr);border:1px solid #087dc7;border-radius:16px;background:rgba(2,18,43,.98)}.nav a,.nav span{display:flex;flex-direction:column;align-items:center;justify-content:center;border-right:1px solid #145a8b;color:#d9edf8;text-decoration:none;font-size:8px;letter-spacing:.05em}.nav i{font-style:normal;color:#61dbff;font-size:21px;margin-bottom:4px}
@media(max-width:1150px){.main{grid-template-columns:260px 1fr 260px;gap:3%}.card{padding:10px;gap:10px}.ico{flex-basis:57px;height:57px;font-size:28px}.num{font-size:28px}.hubtxt b,.hubtxt strong{font-size:30px}.iiicon{display:none}}
