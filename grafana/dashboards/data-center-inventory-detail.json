      "targets":[{"format":"table","rawQuery":true,"rawSql":"SELECT initcap(s.health_status) AS \"Health\",s.name AS \"Data Center\",s.site_key AS \"Site Key\",s.region AS \"Region\",concat_ws(', ',s.address->>'city',s.address->>'country') AS \"Location\",s.timezone AS \"Timezone\",coalesce(s.attributes->>'tier','Not classified') AS \"Facility Tier\",(SELECT count(*) FROM inventory.rooms rm WHERE rm.site_id=s.id) AS \"Rooms\",(SELECT count(*) FROM inventory.racks r JOIN inventory.data_center_rows dr ON dr.id=r.row_id JOIN inventory.rooms rm ON rm.id=dr.room_id WHERE rm.site_id=s.id) AS \"Racks\",round(s.facility_power_capacity_kw/1000.0,2) AS \"Power Capacity MW\",round(s.facility_power_used_kw/1000.0,2) AS \"Power Used MW\",round(100*s.facility_power_used_kw/nullif(s.facility_power_capacity_kw,0),1) AS \"Facility Load %\",round(s.cooling_capacity_kw/1000.0,2) AS \"Cooling Capacity MW\",s.temperature_c AS \"Temperature °C\",s.humidity_pct AS \"Humidity %\",s.pue AS \"PUE\",s.monitoring_coverage_pct AS \"Monitoring %\",s.inventory_completeness_pct AS \"Inventory Complete %\",(SELECT count(*) FROM inventory.data_center_backbone_overview d WHERE d.source_site_key=s.site_key OR d.target_site_key=s.site_key) AS \"DCI Links\",CASE WHEN s.is_simulated THEN 'Simulated' ELSE 'Live' END AS \"Data Type\" FROM inventory.sites s WHERE ('${site:raw}'='All' OR s.site_key='${site:raw}') ORDER BY s.name","refId":"A"}],
