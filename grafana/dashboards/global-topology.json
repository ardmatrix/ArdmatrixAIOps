      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "refId": "nodes",
          "rawSql": "SELECT site_key::text AS id,site_name AS title,region AS \"subTitle\",servers::text||' Servers · '||virtual_machines::text||' VMs' AS \"mainStat\",'WAN RTR A/B · '||dci_links::text||' DCI circuits · '||initcap(health_status) AS \"secondaryStat\",CASE WHEN health_status='healthy' THEN 1 ELSE 0.75 END AS \"arc__healthy\",CASE WHEN health_status='critical' THEN 1 ELSE 0 END AS \"arc__critical\",servers AS \"detail__Servers\",virtual_machines AS \"detail__Virtual Machines\",k8s_nodes AS \"detail__Kubernetes Nodes\",k8s_pods AS \"detail__Pods\",applications AS \"detail__Applications\" FROM inventory.site_full_stack_topology_overview WHERE site_key IN ('dc-chicago','dc-london','dc-singapore','dc-mumbai') ORDER BY site_name"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "refId": "edges",
          "rawSql": "SELECT link_key::text AS id,source_site_key::text AS source,target_site_key::text AS target,provider||' · '||round(bandwidth_bps/1000000000.0)::text||' Gbps' AS \"mainStat\",circuit_id||' · '||round(latency_ms,1)::text||' ms · '||initcap(status) AS \"secondaryStat\",CASE WHEN provider='Airtel' THEN '#22d3ee' ELSE '#a78bfa' END AS color FROM inventory.data_center_backbone_overview WHERE source_site_key IN ('dc-chicago','dc-london','dc-singapore','dc-mumbai') AND target_site_key IN ('dc-chicago','dc-london','dc-singapore','dc-mumbai') ORDER BY source_site_key,target_site_key,provider"
        }
      ],
      "transparent": true,
      "type": "ardmatrix-dci-mesh-panel",
      "title": ""
    }
